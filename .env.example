# Copy this file to `.env` and fill in real values. NEVER commit `.env` —
# it is git-ignored (see .gitignore). Rotated/leaked keys must be revoked
# in the provider dashboard, not just deleted from disk.

# --- OpenAI (dataset/enrich.py; later: the /ask service) -------------------
# Best practice: one key per environment so a leaked R&D key can be revoked
# without touching prod. Set a monthly spend limit on each key at
# platform.openai.com -> API keys.
#   R&D key:  low cap, used locally and in CI
#   Prod key: injected only by the hosting platform (fly secrets / Render)
OPENAI_API_KEY=

# --- PostgreSQL (recipe store, vectors, FTS, request logs; ADR-003) -------
# One connection string for everything. Dev: local Docker
# (pgvector/pgvector:pg16) or the provider's dev branch; prod: injected only
# by the hosting platform's secret store. The API fail-fasts (503) on boot if
# the DB corpus_version does not match the committed corpus.
DATABASE_URL=

# Public API abuse protection (per process/client address)
REQUEST_RATE_LIMIT=10
REQUEST_RATE_WINDOW_SECONDS=60
